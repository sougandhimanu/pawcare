<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background with border -->
    <item>
        <shape>
            <solid android:color="#FFFFFF"/> <!-- Background color -->
            <stroke android:width="1dp" android:color="#BDBDBD"/> <!-- Border color and width -->
            <corners android:radius="4dp"/> <!-- Border corner radius -->
        </shape>
    </item>
    <!-- Dropdown arrow -->
    <item android:drawable="@drawable/ddarrow" android:gravity="right|center_vertical" android:width="24dp" android:height="24dp" android:right="8dp"/>
</layer-list>
